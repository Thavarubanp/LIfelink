# LifeLink Inventory Management Agent (shortage, expiry and transfer recommendations)

# Shared with the backend (InternalService:ApiKey) and the Supervisor
INTERNAL_SERVICE_API_KEY=LifeLink-Internal-Agent-Key-2026

# The backend runs inventory checks through the Supervisor (backend setting InventoryMonitoring:IntervalMinutes).
# The agent's own polling scheduler is only for standalone use; keep it off when the backend is running.
SCHEDULER_ENABLED=false
SCHEDULE_INTERVAL_MINUTES=30
BACKEND_API_URL=http://127.0.0.1:5231
INVENTORY_ENDPOINT=/api/inventory
NOTIFICATION_ENDPOINT=/api/notifications/recommendations
REQUEST_TIMEOUT=30
