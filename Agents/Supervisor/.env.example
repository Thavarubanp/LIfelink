# LifeLink Supervisor Agent (replaces the Planning Agent; same port, /plan kept)
HOST=127.0.0.1
PORT=8004
LOG_LEVEL=INFO

# Shared with the backend (InternalService:ApiKey) and every worker agent
INTERNAL_SERVICE_API_KEY=LifeLink-Internal-Agent-Key-2026

# Worker agents
AGENT1_SCREENING_URL=http://127.0.0.1:8001
AGENT2_MATCHING_URL=http://127.0.0.1:8000
AGENT3_INVENTORY_URL=http://127.0.0.1:8003
HTTP_TIMEOUT_SECONDS=20

# Gemini: chat, intent classification, grounded answers and embeddings for RAG.
# Without a key the Supervisor still works: rule-based routing and keyword retrieval.
GOOGLE_API_KEY=
MODEL_NAME=gemini-2.5-flash
EMBEDDING_MODEL=models/gemini-embedding-001
# Cosine distance cut-off for knowledge hits; re-tune if the embedding model changes (see README)
RETRIEVAL_MAX_DISTANCE=0.40
