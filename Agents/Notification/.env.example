# LifeLink Notification Agent (donor and hospital alerts)

# Gemini ranks eligible donors and words the alerts. Without a key, deterministic ranking and templates are used.
GOOGLE_API_KEY=
MODEL_NAME=gemini-2.5-flash

# Shared with the backend (InternalService:ApiKey) and the Supervisor
INTERNAL_SERVICE_API_KEY=LifeLink-Internal-Agent-Key-2026

# Loopback only: the Supervisor and the backend are the only callers
HOST=127.0.0.1
PORT=8000
