# LifeLink Request Management Agent (donor screening interview and versioned screening reports)

# Loopback only: the backend and the Supervisor are the only callers
HOST=127.0.0.1
PORT=8001
ENVIRONMENT=development

# Agent-owned tables (screening sessions, answers, report versions). Local SQLite by default.
# A database created before report versioning needs `alembic upgrade head` (see README).
DATABASE_URL=sqlite:///./screening_agent.db

# Gemini writes the de-identified report summary. Without a key a rule-based summary is used.
GEMINI_API_KEY=
MODEL_NAME=gemini-3.5-flash-lite

# Backend REST API. The key must match the backend's InternalService:ApiKey and the other agents.
BACKEND_BASE_URL=http://127.0.0.1:5231
INTERNAL_SERVICE_API_KEY=replace-with-a-strong-shared-secret
