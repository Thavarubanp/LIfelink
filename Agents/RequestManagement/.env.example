# LifeLink Student 1 AI-Powered Donor Screening Agent Environment Configuration

# Service Network Configuration
HOST=0.0.0.0
PORT=8001
ENVIRONMENT=development

# Database Connection (Dedicated Agent SQLite or PostgreSQL)
# Default uses local SQLite for agent tables; Neon PostgreSQL URL can be substituted
DATABASE_URL=sqlite:///./screening_agent.db

# LLM Configuration
GEMINI_API_KEY=
MODEL_NAME=gemini-2.5-flash

# Backend Core REST API Integration
BACKEND_BASE_URL=http://localhost:5231
INTERNAL_SERVICE_API_KEY=LifeLink-Internal-Agent-Key-2026

# Generated Reports Output Directory
REPORTS_DIR=./reports/generated
